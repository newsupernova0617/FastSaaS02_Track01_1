{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-21",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "AI_PROVIDER": "openai",
    "ALLOWED_ORIGINS": "http://localhost:3000,http://localhost:5173,http://localhost:4321,https://fastsaas02-track01-1.pages.dev,https://fastsaas02-track01-1-webapp.pages.dev,https://landing-page-7hu.pages.dev",
    "AI_API_BASE_URL": "http://localhost:8788"
  },
  "observability": {
    "logs": {
      "enabled": true
    }
  }
}
