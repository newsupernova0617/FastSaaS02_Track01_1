---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import { site } from '../content';

const updatedAt = '2026-05-11';
const privacyInquiryMailto = `mailto:${site.contactEmail}?subject=${encodeURIComponent('쉬운AI가계부 개인정보 문의')}`;

const quickFacts = [
  { label: '운영자', value: site.brand },
  { label: '문의', value: site.contactEmail },
  { label: '적용 범위', value: '웹 · 모바일 앱 · 백엔드 API' },
  { label: '계정 삭제', value: '앱 설정과 웹 페이지에서 요청 가능' },
] as const;

const dataCategories = [
  {
    title: '계정 및 인증 정보',
    description: '회원 가입과 로그인, 계정 식별에 필요한 정보입니다.',
    items: ['이메일, 이름, 프로필 사진 URL', '로그인 제공자 정보', '사용자 ID 및 세션 관련 정보'],
  },
  {
    title: '재무 및 서비스 사용 데이터',
    description: '가계부 기능과 리포트 생성을 위해 처리하는 핵심 데이터입니다.',
    items: ['거래 내역, 카테고리, 메모, 날짜', '월간/주간 리포트와 요약 데이터', '복원/수정 이력과 세션 정보'],
  },
  {
    title: 'AI 입력 및 생성 결과',
    description: '자연어 기록과 대화형 분석을 제공하기 위해 필요한 정보입니다.',
    items: ['AI 채팅 메시지와 세션 제목', '명확화(clarification) 기록', 'AI가 생성한 분석, 요약, 답변'],
  },
  {
    title: '문의 및 지원 정보',
    description: '버그 신고, 기능 제안, 계정/결제 문의를 처리할 때 사용됩니다.',
    items: ['문의 내용과 첨부한 설명', '자동 첨부된 앱 버전 및 환경 정보', '처리 결과를 추적하기 위한 내부 기록'],
  },
  {
    title: '결제 및 구독 정보',
    description: 'Android 구독 검증과 프리미엄 권한 확인에 필요한 정보입니다. 결제수단 정보는 Google Play가 처리합니다.',
    items: ['Google Play 구독 상태', '상품 ID와 구매 토큰', '만료 정보 및 권한 상태'],
  },
  {
    title: '광고 및 기술 로그',
    description: '광고 노출과 서비스 안정성을 위해 필요한 최소 정보입니다.',
    items: ['광고 식별자와 기기/앱 정보', '광고 노출·클릭·측정 이벤트', '기본 접속 로그와 오류 로그'],
  },
] as const;

const processors = [
  {
    name: 'Supabase',
    use: '인증 및 사용자 세션 관리',
    data: '이메일, 로그인 제공자, 사용자 ID, 세션 관련 데이터',
  },
  {
    name: 'Cloudflare Workers / Pages',
    use: '웹사이트 및 API 호스팅',
    data: '요청 메타데이터, 접속 로그, 오류 로그',
  },
  {
    name: 'Turso / SQLite / Drizzle ORM',
    use: '서비스 데이터 저장',
    data: '거래, 리포트, 대화, 메모, 구독 상태',
  },
  {
    name: 'Cloudflare Workers AI',
    use: 'AI 분석 및 자연어 대화 처리',
    data: '사용자가 입력한 문장, 필요한 대화 맥락, 생성된 응답',
  },
  {
    name: 'Google Play Billing',
    use: 'Android 구독 검증 및 상태 관리',
    data: '상품 ID, 구매 토큰, 구독 상태',
  },
  {
    name: 'Google Mobile Ads',
    use: '광고 제공 및 측정',
    data: '광고 식별자, 기기/앱 정보, 광고 노출·클릭 이벤트',
  },
] as const;

const retentionItems = [
  {
    title: '계정, 거래, 대화, 메모, 리포트',
    body: '서비스 이용 중 생성되는 핵심 데이터로, 계정 삭제 요청 시 삭제 대상입니다.',
  },
  {
    title: '결제 및 구독 기록',
    body: '법적 의무, 정산, 분쟁 대응에 필요한 최소 범위만 보관합니다.',
  },
  {
    title: '문의 및 지원 내역',
    body: '이슈 해결과 후속 대응에 필요한 기간 동안만 보관할 수 있습니다.',
  },
  {
    title: '보안 로그 및 백업 데이터',
    body: '보안, 복구, 장애 대응에 필요한 최소 기간 후 순차 삭제합니다.',
  },
] as const;

const securityItems = [
  '서버는 인증된 사용자만 자신의 데이터에 접근할 수 있도록 설계되어 있습니다.',
  'JWT 기반 인증과 사용자 소유권 검증을 통해 다른 사용자의 데이터 접근을 차단합니다.',
  '전송 구간은 HTTPS를 사용하며, 서비스 동작에 꼭 필요한 정보만 저장합니다.',
  'AI 처리에는 거래 입력과 대화 맥락처럼 필요한 최소한의 문맥만 사용합니다.',
] as const;
---

<BaseLayout title="개인정보처리방침" description="쉬운AI가계부 서비스의 개인정보처리방침입니다.">
  <main class="mx-auto max-w-5xl px-6 py-16 sm:py-24">
    <a href="/" class="app-link text-sm">← 홈으로</a>

    <section class="mt-4 overflow-hidden rounded-[2rem] border border-base-300 bg-gradient-to-br from-base-100 via-base-100 to-base-200 shadow-sm">
      <div class="grid gap-0 lg:grid-cols-[1.15fr_0.85fr]">
        <div class="p-8 sm:p-10">
          <p class="text-xs font-semibold uppercase tracking-[0.24em] text-base-content/45">Privacy Policy</p>
          <div class="mt-4 flex flex-wrap items-center gap-3">
            <h1 class="text-3xl font-bold sm:text-4xl">개인정보처리방침</h1>
            <span class="rounded-full border border-base-300 bg-base-100 px-3 py-1 text-xs font-semibold text-base-content/60">
              최종 업데이트 {updatedAt}
            </span>
          </div>

          <p class="mt-5 max-w-2xl text-base leading-7 text-base-content/75">
            이 정책은 쉬운AI가계부 웹사이트, 모바일 앱, 백엔드 서비스를 포함한 전체 서비스에 적용됩니다.
            어떤 정보를 수집하는지, 왜 처리하는지, 누구와 공유하는지, 그리고 어떻게 삭제되는지를 아래에 명확히 설명합니다.
          </p>

          <div class="mt-8 flex flex-wrap gap-3">
            <a href="#data" class="app-btn app-btn-primary px-5 py-3">수집 정보 보기</a>
            <a href="#deletion" class="app-btn border border-base-300 bg-base-100 px-5 py-3 font-semibold text-base-content">
              삭제 정책 보기
            </a>
            <a href="/account-deletion" class="app-btn border border-base-300 bg-base-100 px-5 py-3 font-semibold text-base-content">
              계정 삭제 요청
            </a>
          </div>
        </div>

        <div class="border-t border-base-300 bg-base-100/80 p-8 sm:p-10 lg:border-l lg:border-t-0">
          <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-1">
            {quickFacts.map((fact) => (
              <div class="rounded-2xl border border-base-300 bg-base-100 p-4 shadow-sm">
                <p class="text-xs font-semibold uppercase tracking-[0.16em] text-base-content/45">{fact.label}</p>
                <p class="mt-2 text-sm font-medium text-base-content">{fact.value}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="mt-12 rounded-3xl border border-base-300 bg-base-100 p-8 shadow-sm">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.24em] text-base-content/45">Summary</p>
          <h2 class="mt-2 text-2xl font-bold text-base-content">한눈에 보기</h2>
        </div>
        <p class="max-w-2xl text-sm leading-6 text-base-content/65">
          Google Play 심사와 사용자 안내를 위해, 이 서비스가 다루는 데이터와 외부 처리 주체를 먼저 요약합니다.
        </p>
      </div>

      <div class="mt-6 grid gap-4 md:grid-cols-2 xl:grid-cols-4">
        <div class="rounded-2xl border border-base-300 bg-base-200/60 p-5">
          <p class="text-xs font-semibold uppercase tracking-[0.16em] text-base-content/45">수집</p>
          <p class="mt-2 text-sm font-medium text-base-content">계정, 거래, AI 대화, 결제, 광고, 문의 정보</p>
        </div>
        <div class="rounded-2xl border border-base-300 bg-base-200/60 p-5">
          <p class="text-xs font-semibold uppercase tracking-[0.16em] text-base-content/45">이용</p>
          <p class="mt-2 text-sm font-medium text-base-content">기록 저장, 분석 리포트, 구독 확인, 지원 응답</p>
        </div>
        <div class="rounded-2xl border border-base-300 bg-base-200/60 p-5">
          <p class="text-xs font-semibold uppercase tracking-[0.16em] text-base-content/45">공유</p>
          <p class="mt-2 text-sm font-medium text-base-content">Supabase, Cloudflare, Turso, Google Play, Google Mobile Ads, Workers AI</p>
        </div>
        <div class="rounded-2xl border border-base-300 bg-base-200/60 p-5">
          <p class="text-xs font-semibold uppercase tracking-[0.16em] text-base-content/45">삭제</p>
          <p class="mt-2 text-sm font-medium text-base-content">앱/웹에서 요청 가능, 핵심 데이터는 삭제 대상</p>
        </div>
      </div>
    </section>

    <div class="mt-12 space-y-10">
      <section id="data" class="rounded-3xl border border-base-300 bg-base-100 p-8 shadow-sm">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.24em] text-base-content/45">01</p>
            <h2 class="mt-2 text-2xl font-bold text-base-content">수집하는 정보</h2>
          </div>
          <p class="max-w-2xl text-sm leading-6 text-base-content/65">
            서비스 운영에 꼭 필요한 범위에서만 데이터를 처리합니다. 입력하지 않은 민감한 정보는 기본적으로 요구하지 않습니다.
          </p>
        </div>

        <div class="mt-6 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
          {dataCategories.map((category) => (
            <article class="rounded-2xl border border-base-300 bg-base-100 p-5 shadow-sm">
              <h3 class="text-lg font-semibold text-base-content">{category.title}</h3>
              <p class="mt-2 text-sm leading-6 text-base-content/70">{category.description}</p>
              <ul class="mt-4 space-y-2 text-sm leading-6 text-base-content/80">
                {category.items.map((item) => (
                  <li class="flex gap-2">
                    <span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-primary/70"></span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </section>

      <section class="rounded-3xl border border-base-300 bg-base-100 p-8 shadow-sm">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.24em] text-base-content/45">02</p>
            <h2 class="mt-2 text-2xl font-bold text-base-content">이용 목적</h2>
          </div>
          <p class="max-w-2xl text-sm leading-6 text-base-content/65">
            수집한 정보는 아래 목적을 벗어나지 않도록 제한해서 사용합니다.
          </p>
        </div>

        <ul class="mt-6 grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
          <li class="rounded-2xl border border-base-300 bg-base-200/50 p-4 text-sm leading-6 text-base-content/85">회원 인증 및 계정 관리</li>
          <li class="rounded-2xl border border-base-300 bg-base-200/50 p-4 text-sm leading-6 text-base-content/85">거래 기록, 검색, 수정, 삭제, 복원 기능 제공</li>
          <li class="rounded-2xl border border-base-300 bg-base-200/50 p-4 text-sm leading-6 text-base-content/85">AI 기반 분석 리포트와 자연어 대화 기능 제공</li>
          <li class="rounded-2xl border border-base-300 bg-base-200/50 p-4 text-sm leading-6 text-base-content/85">구독 상태 확인, 결제 검증, 프리미엄 기능 제공</li>
          <li class="rounded-2xl border border-base-300 bg-base-200/50 p-4 text-sm leading-6 text-base-content/85">문의 응답, 장애 대응, 부정 사용 방지</li>
          <li class="rounded-2xl border border-base-300 bg-base-200/50 p-4 text-sm leading-6 text-base-content/85">서비스 품질 개선 및 보안 유지</li>
        </ul>
      </section>

      <section class="rounded-3xl border border-base-300 bg-base-100 p-8 shadow-sm">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.24em] text-base-content/45">03</p>
            <h2 class="mt-2 text-2xl font-bold text-base-content">제3자 제공 및 처리 위탁</h2>
          </div>
          <p class="max-w-2xl text-sm leading-6 text-base-content/65">
            각 외부 서비스는 기능 수행에 필요한 최소 범위의 데이터만 처리합니다.
          </p>
        </div>

        <div class="mt-6 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
          {processors.map((processor) => (
            <article class="rounded-2xl border border-base-300 bg-base-100 p-5 shadow-sm">
              <h3 class="text-lg font-semibold text-base-content">{processor.name}</h3>
              <p class="mt-2 text-sm font-medium text-base-content/80">{processor.use}</p>
              <p class="mt-3 text-sm leading-6 text-base-content/70">{processor.data}</p>
            </article>
          ))}
        </div>

        <p class="mt-6 text-sm leading-6 text-base-content/70">
          우리는 법령상 요구되거나 사용자 동의가 필요한 경우를 제외하고, 개인정보를 제3자에게 판매하지 않습니다.
        </p>
      </section>

      <section id="deletion" class="rounded-3xl border border-base-300 bg-base-100 p-8 shadow-sm">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.24em] text-base-content/45">04</p>
            <h2 class="mt-2 text-2xl font-bold text-base-content">보관 및 삭제</h2>
          </div>
          <p class="max-w-2xl text-sm leading-6 text-base-content/65">
            계정이 유지되는 동안만 필요한 데이터를 보관하고, 삭제 요청 시 가능한 한 빠르게 정리합니다.
          </p>
        </div>

        <div class="mt-6 grid gap-4 lg:grid-cols-2">
          {retentionItems.map((item) => (
            <article class="rounded-2xl border border-base-300 bg-base-200/50 p-5">
              <h3 class="text-base font-semibold text-base-content">{item.title}</h3>
              <p class="mt-2 text-sm leading-6 text-base-content/75">{item.body}</p>
            </article>
          ))}
        </div>
      </section>

      <section id="rights" class="rounded-3xl border border-base-300 bg-base-100 p-8 shadow-sm">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.24em] text-base-content/45">05</p>
            <h2 class="mt-2 text-2xl font-bold text-base-content">이용자의 권리</h2>
          </div>
          <p class="max-w-2xl text-sm leading-6 text-base-content/65">
            열람, 수정, 삭제, 처리 정지, 계정 삭제를 요청할 수 있습니다.
          </p>
        </div>

        <div class="mt-6 rounded-2xl border border-primary/20 bg-primary/5 p-6">
          <p class="text-sm leading-6 text-base-content/80">
            계정 삭제를 가장 빠르게 요청하려면 <a href="/account-deletion" class="font-semibold underline decoration-primary/60 decoration-2 underline-offset-4">계정 삭제 요청 페이지</a>를 이용해 주세요.
            모바일 앱의 설정 화면에서도 동일한 안내를 확인할 수 있습니다.
          </p>
          <div class="mt-5 flex flex-wrap gap-3">
            <a href="/account-deletion" class="app-btn app-btn-primary px-5 py-3">계정 삭제 요청</a>
            <a href={privacyInquiryMailto} class="app-btn border border-base-300 bg-base-100 px-5 py-3 font-semibold text-base-content">
              이메일로 문의
            </a>
          </div>
        </div>
      </section>

      <section class="rounded-3xl border border-base-300 bg-base-100 p-8 shadow-sm">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.24em] text-base-content/45">06</p>
            <h2 class="mt-2 text-2xl font-bold text-base-content">안전한 정보 보호</h2>
          </div>
          <p class="max-w-2xl text-sm leading-6 text-base-content/65">
            기술적·관리적 보호 조치를 통해 다른 사용자의 데이터가 노출되지 않도록 설계합니다.
          </p>
        </div>

        <ul class="mt-6 grid gap-3 md:grid-cols-2">
          {securityItems.map((item) => (
            <li class="rounded-2xl border border-base-300 bg-base-200/50 p-4 text-sm leading-6 text-base-content/80">{item}</li>
          ))}
        </ul>
      </section>

      <section class="rounded-3xl border border-base-300 bg-base-100 p-8 shadow-sm">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.24em] text-base-content/45">07</p>
            <h2 class="mt-2 text-2xl font-bold text-base-content">문의</h2>
          </div>
          <p class="max-w-2xl text-sm leading-6 text-base-content/65">
            개인정보, 계정 삭제, 결제 문의는 아래 경로로 연락해 주세요.
          </p>
        </div>

        <div class="mt-6 rounded-2xl border border-base-300 bg-base-200/50 p-6">
          <dl class="grid gap-4 sm:grid-cols-2">
            <div>
              <dt class="text-xs font-semibold uppercase tracking-[0.16em] text-base-content/45">이메일</dt>
              <dd class="mt-2 text-sm font-medium text-base-content">
                <a href={`mailto:${site.contactEmail}`} class="app-link">{site.contactEmail}</a>
              </dd>
            </div>
            <div>
